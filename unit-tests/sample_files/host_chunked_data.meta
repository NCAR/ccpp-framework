# Host metadata for the chunked_data integration test.
# Tests a scheme that uses ccpp_chunk_number as a control variable and
# accesses a DDT-based data array.  Chunk loop bounds are provided as
# scalars (the host manages chunking externally).

[ccpp-table-properties]
  name = chunked_data_mod
  type = host

[ccpp-arg-table]
  name = chunked_data_mod
  type = host

[ ncols ]
  standard_name = horizontal_dimension
  long_name = full horizontal dimension
  units = count
  dimensions = ()
  type = integer
[ chunked_data_instance ]
  standard_name = chunked_data_type_instance
  long_name = instance of chunked_data_type
  units = DDT
  dimensions = ()
  type = chunked_data_type
